<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <VBox spacing="0">
            <!-- Barra de filtros -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #f5f5f5;                          -fx-border-color: #d8d8d8;                          -fx-border-width: 0 0 1 0;                          -fx-padding: 10 12;">

                <Label style="-fx-font-size: 11; -fx-font-family: 'Segoe UI';                               -fx-text-fill: #333333;" text="Buscar:" />
                <TextField fx:id="txtBusca" prefHeight="24" prefWidth="200" promptText="Nome, CPF, Cargo..." style="-fx-font-size: 11; -fx-font-family: 'Segoe UI';                                   -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;" />

                <Separator orientation="VERTICAL" style="-fx-background-color: #cccccc;" />

                <CheckBox fx:id="chkAtivo" style="-fx-font-size: 11; -fx-font-family: 'Segoe UI'; -fx-text-fill: #333333;" text="Apenas ativos" />

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#limparFiltros" prefHeight="24" style="-fx-background-color: transparent;                                -fx-border-color: #194e8f;                                -fx-text-fill: #194e8f;                                -fx-border-width: 1;                                -fx-font-size: 11;                                -fx-font-family: 'Segoe UI';                                -fx-cursor: hand;" text="Limpar Filtros" />
            </HBox>

            <!-- Contador -->
            <HBox style="-fx-background-color: #f5f5f5;                          -fx-border-color: #d8d8d8;                          -fx-border-width: 0 0 1 0;                          -fx-padding: 6 10;">
                <Label fx:id="lblTotalRegistros" style="-fx-font-size: 11; -fx-font-family: 'Segoe UI';                               -fx-text-fill: #333333;" text="Registros: 0" />
            </HBox>

            <SplitPane dividerPositions="0.87">

            <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;                                -fx-border-color: transparent;" vbarPolicy="NEVER">

                <TableView fx:id="tableView" prefHeight="600" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                        <TableColumn fx:id="colNome" prefWidth="220" text="Nome" />
                        <TableColumn fx:id="colCpf" prefWidth="130" text="CPF" />
                        <TableColumn fx:id="colCargo" prefWidth="140" text="Cargo" />
                        <TableColumn fx:id="colAdmissao" prefWidth="100" text="Admissão" />
                        <TableColumn fx:id="colDemissao" prefWidth="100" text="Demissão" />
                        <TableColumn fx:id="colTelefone" prefWidth="130" text="Telefone" />
                        <TableColumn fx:id="colEmail" prefWidth="160" text="Email" />
                        <TableColumn fx:id="colAtivo" prefWidth="60" text="Ativo" />
                    </columns>
                </TableView>
            </ScrollPane>

            <!-- Painel lateral de botões -->
            <VBox alignment="TOP_CENTER" minWidth="110" prefWidth="150" spacing="6" style="-fx-background-color: #f5f5f5;                          -fx-border-color: #cccccc;                          -fx-border-width: 0 0 0 1;" SplitPane.resizableWithParent="false">
                <padding><Insets bottom="12" left="10" right="10" top="12" /></padding>

                <Button fx:id="btnNovo" maxWidth="Infinity" onAction="#abrirFormNovo" prefHeight="32" style="-fx-background-color: #194e8f;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-font-size: 11;                                -fx-font-family: 'Segoe UI';                                -fx-cursor: hand;" text="Novo" />

                <Button fx:id="btnEditar" maxWidth="Infinity" onAction="#abrirFormEdicao" prefHeight="32" style="-fx-background-color: transparent;                                -fx-border-color: #cccccc;                                -fx-border-width: 1;                                -fx-font-size: 11;                                -fx-font-family: 'Segoe UI';                                -fx-cursor: hand;" text="Editar" />

                <Button fx:id="btnExcluir" maxWidth="Infinity" onAction="#excluirSelecionado" prefHeight="32" style="-fx-background-color: transparent;                                -fx-border-color: #c0392b;                                -fx-text-fill: #c0392b;                                -fx-border-width: 1;                                -fx-font-size: 11;                                -fx-font-family: 'Segoe UI';                                -fx-cursor: hand;" text="Excluir" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator />
            </VBox>
            </SplitPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="28" spacing="0" style="-fx-background-color: #e4e4e4;                      -fx-border-color: #bbbbbb;                      -fx-border-width: 1 0 0 0;                      -fx-padding: 0 10;">
            <Label fx:id="lblStatus" style="-fx-text-fill: #555555;                           -fx-font-size: 11;                           -fx-font-family: 'Segoe UI';" text="" />
        </HBox>
    </bottom>

</BorderPane>
