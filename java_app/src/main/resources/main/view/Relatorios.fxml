<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4" style="-fx-background-color: #f7f7f7;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.controllers.RelatoriosController">
    <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

    <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #194e8f;" text="Relatórios" />
    <Label style="-fx-font-size: 11; -fx-font-family: 'Segoe UI'; -fx-text-fill: #666666;" text="Selecione um relatório para consultar e exportar." />

    <FlowPane hgap="16" vgap="16" style="-fx-padding: 16 0 0 0;">

        <!-- Card: Relatório de Estoque -->
        <VBox alignment="TOP_LEFT" prefWidth="260" spacing="8" style="-fx-background-color: white; -fx-border-color: #d8d8d8; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
            <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                <Image url="@../resources/svg/box.png" />
            </ImageView>
            <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #333333;" text="Relatório de Estoque" />
            <Label maxWidth="228" style="-fx-font-size: 11; -fx-font-family: 'Segoe UI'; -fx-text-fill: #666666;" text="Posição atual do estoque por produto e categoria, com valores totais e exportação em PDF." wrapText="true" />
            <Button maxWidth="Infinity" onAction="#abrirRelatorioEstoque" prefHeight="30" style="-fx-background-color: #194e8f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Abrir" />
        </VBox>

        <!-- Card: Vendas -->
        <VBox alignment="TOP_LEFT" prefWidth="260" spacing="8" style="-fx-background-color: white; -fx-border-color: #d8d8d8; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 16;">
            <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                <Image url="@../resources/svg/chart-line-solid-full.png" />
            </ImageView>
            <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #333333;" text="Vendas" />
            <Label maxWidth="228" style="-fx-font-size: 11; -fx-font-family: 'Segoe UI'; -fx-text-fill: #666666;" text="Consulta de vendas por período com total do dia, número de vendas e ticket médio." wrapText="true" />
            <Button maxWidth="Infinity" onAction="#abrirRelatorioVendas" prefHeight="30" style="-fx-background-color: #194e8f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Abrir" />
        </VBox>

    </FlowPane>
</VBox>
